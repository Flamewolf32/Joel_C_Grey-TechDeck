@model TechDesk.Models.Device

<h2>Delete Device</h2>
<h3 class="text-danger">Are you sure you want to delete @Model.AssetTag (@Model.Name)?</h3>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-3">
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a asp-action="Index" class="btn btn-secondary">No, Go Back</a>
</form>
