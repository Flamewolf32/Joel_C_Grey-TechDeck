@model TechDesk.Models.Device

<h2>Device Details</h2>
<div>
    <dl class="row">
        <dt class="col-sm-2">Asset tag</dt>
        <dd class="col-sm-10">@Model.AssetTag</dd>
        <dt class="col-sm-2">Device name</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        <dt class="col-sm-2">Category</dt>
        <dd class="col-sm-10">@Model.Category</dd>
        <dt class="col-sm-2">Year bought</dt>
        <dd class="col-sm-10">@Model.PurchaseYear</dd>
        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@(Model.IsOnLoan ? "on loan" : "available")</dd>
    </dl>
</div>
<div>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
